# Copy this file to .env (same folder) and set where your journal data lives.
# Use a folder inside Dropbox / Google Drive / iCloud Drive to share it between computers.
#
# macOS examples:
#   JOURNAL_DATA_DIR=/Users/yourname/Dropbox/TradingJournal
#   JOURNAL_DATA_DIR=/Users/yourname/Library/Mobile Documents/com~apple~CloudDocs/TradingJournal
# Windows example:
#   JOURNAL_DATA_DIR=C:\Users\yourname\Dropbox\TradingJournal
JOURNAL_DATA_DIR=
